# Server Environment Configuration
PORT=5000
NODE_ENV=production

# Strong 256-bit JWT secret (generate one for production)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string

# Allowed CORS Origins (Comma-separated)
CORS_ORIGIN=https://your-production-domain.com,http://localhost:5173

# Institution Branding
VITE_INSTITUTION_NAME="Chaitanya (Deemed to be University)"

# Neon Cloud PostgreSQL Connection String (from console.neon.tech)
# Example: postgresql://neondb_owner:password@ep-cold-pond-123456.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

